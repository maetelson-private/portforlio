---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { url } from '../lib/url';

interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const p = project.data;
---

<li class="pc reveal">
  <a href={url(`/projects/${project.id}/`)} class="link">
    <div class="top">
      <span class="mono">{p.period}</span>
      <span class="arrow" aria-hidden="true"><Icon name="arrow-up-right" size={16} /></span>
    </div>
    <h3>
      {p.featured && <span class="star" title="대표 프로젝트">★</span>}
      {p.title}
    </h3>
    <p class="sum">{p.summary}</p>
    {
      p.award && (
        <p class="award">
          <Icon name="trophy" size={14} />
          {p.award}
        </p>
      )
    }
    <div class="foot">
      <ul class="roles">
        {p.roles.slice(0, 4).map((r) => (
          <li class="tag">{r}</li>
        ))}
      </ul>
      {
        p.links.repoPrivate && (
          <span class="tag" title="비공개 레포 — 요청 시 코드 공유">
            <Icon name="lock" size={12} />
            &nbsp;Private
          </span>
        )
      }
    </div>
    {p.org && <p class="org mono">{p.org}</p>}
  </a>
</li>

<style>
  .pc {
    list-style: none;
  }
  .link {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
    height: 100%;
    padding: 24px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    background: linear-gradient(180deg, var(--surface), var(--bg-elev));
    transition: border-color 0.3s, transform 0.4s var(--ease), background 0.3s;
  }
  .link:hover {
    border-color: var(--green-line);
    transform: translateY(-3px);
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .arrow {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    color: var(--text-2);
    transition: background 0.3s, color 0.3s, border-color 0.3s;
  }
  .link:hover .arrow {
    background: var(--green);
    border-color: var(--green);
    color: #03140c;
  }
  h3 {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.3;
  }
  .star {
    color: var(--green);
    margin-right: 6px;
    font-size: 15px;
    vertical-align: 2px;
  }
  .sum {
    color: var(--text-2);
    font-size: 14px;
    line-height: 1.65;
  }
  .award {
    display: flex;
    gap: 8px;
    align-items: flex-start;
    font-size: 13px;
    color: var(--green);
    line-height: 1.5;
  }
  .award :global(svg) {
    flex: none;
    margin-top: 2px;
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: auto;
    padding-top: 6px;
  }
  .roles {
    display: contents;
  }
  .org {
    padding-top: 12px;
    border-top: 1px solid var(--line);
    font-size: 11px;
  }
</style>
