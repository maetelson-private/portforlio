---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { url } from '../lib/url';

interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const p = project.data;
---

<li class="row reveal">
  <a href={url(`/projects/${project.id}/`)} class="link">
    <span class="period">{p.period}</span>
    <div class="main">
      <h3>
        {p.title}
        {p.featured && <span class="star">Featured</span>}
        {p.links.repoPrivate && (
          <span class="lock" title="Private repository, available on request">
            <Icon name="lock" size={12} />
          </span>
        )}
      </h3>
      <p class="sum">{p.summary}</p>
      <p class="roles">{p.roles.join(' · ')}</p>
    </div>
    <div class="aside">
      {
        p.award && (
          <p class="award">
            <Icon name="trophy" size={14} />
            <span>{p.award}</span>
          </p>
        )
      }
    </div>
    <span class="arrow" aria-hidden="true"><Icon name="arrow-up-right" size={16} /></span>
  </a>
</li>

<style>
  .row {
    border-bottom: 1px solid var(--line);
  }
  .link {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 8px 16px;
    padding: 22px 4px;
    transition: background 0.25s;
  }
  .period {
    grid-column: 1 / -1;
    font-size: 13px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .main {
    min-width: 0;
  }
  .aside {
    grid-column: 1 / 2;
  }
  .arrow {
    grid-column: 2;
    grid-row: 2;
    align-self: start;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    color: var(--text-2);
    transition: background 0.25s, color 0.25s, border-color 0.25s;
  }
  @media (min-width: 860px) {
    .link {
      grid-template-columns: 150px minmax(0, 1fr) 280px 32px;
      gap: 32px;
      align-items: start;
      padding: 26px 8px;
    }
    .period {
      grid-column: auto;
      padding-top: 4px;
    }
    .aside,
    .arrow {
      grid-column: auto;
      grid-row: auto;
    }
  }
  .link:hover {
    background: rgba(255, 255, 255, 0.02);
  }
  .link:hover .arrow {
    background: var(--green);
    border-color: var(--green);
    color: #03140c;
  }
  h3 {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.4;
  }
  .link:hover h3 {
    color: var(--green);
  }
  .star {
    padding: 2px 8px;
    border-radius: 999px;
    border: 1px solid var(--green-line);
    font-size: 11px;
    font-weight: 600;
    color: var(--green);
  }
  .lock {
    color: var(--muted);
  }
  .sum {
    margin-top: 6px;
    color: var(--text-2);
    font-size: 15px;
    line-height: 1.6;
  }
  .roles {
    margin-top: 8px;
    font-size: 13px;
    color: var(--muted);
  }
  .award {
    display: flex;
    gap: 8px;
    align-items: flex-start;
    font-size: 13px;
    line-height: 1.55;
    color: var(--green);
  }
  .award :global(svg) {
    flex: none;
    margin-top: 3px;
  }
</style>
