---
import type { CollectionEntry } from 'astro:content';
import ProjectCard from './ProjectCard.astro';
import { disciplines, type DisciplineKey } from '../data/site';

interface Props {
  id: DisciplineKey;
  projects: CollectionEntry<'projects'>[];
}
const { id, projects } = Astro.props;
const d = disciplines[id];
---

<section class="section" id={id} aria-labelledby={`${id}-title`}>
  <div class="container">
    <div class="sec-head reveal">
      <div>
        <span class="eyebrow sec-num">{d.no} — {d.en}</span>
        <h2 id={`${id}-title`}>
          {d.ko}<span class="dot">.</span>
          <span class="sub">{d.lead}</span>
        </h2>
      </div>
      <div>
        <p>{d.desc}</p>
        <ul class="scope">
          {d.scope.map((s) => <li class="tag">{s}</li>)}
        </ul>
      </div>
    </div>

    <ul class="grid">
      {projects.map((p) => <ProjectCard project={p} />)}
    </ul>
    <slot />
  </div>
</section>

<style>
  .dot {
    color: var(--green);
  }
  .sub {
    display: block;
    margin-top: 14px;
    font-family: var(--font-sans);
    font-size: clamp(17px, 1.8vw, 21px);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--text-2);
  }
  .scope {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 18px;
  }
  .grid {
    border-top: 1px solid var(--line-strong);
  }
</style>
