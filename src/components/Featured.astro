---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { axes } from '../data/site';
import { url } from '../lib/url';

interface Props {
  projects: CollectionEntry<'projects'>[];
}
const { projects } = Astro.props;
---

<section class="section featured" id="works" aria-labelledby="featured-title">
  <div class="container">
    <div class="sec-head reveal">
      <h2 id="featured-title">축마다 하나씩,<br /><span class="text-green">가장 깊게 판 작업.</span></h2>
      <p>
        다섯 역량을 대표하는 프로젝트입니다. 나머지 작업은 각 역량 페이지에서 볼 수 있습니다.
      </p>
    </div>

    <ul class="grid">
      {
        projects.map((project, i) => {
          const p = project.data;
          const a = axes[p.primary];
          return (
            <li class="fc reveal" style={`transition-delay:${i * 50}ms`}>
              <a href={url(`/projects/${project.id}/`)} class="link">
                {p.highlight && (
                  <div class="hl">
                    <span class="hl-v">{p.highlight.value}</span>
                    <span class="hl-l">{p.highlight.label}</span>
                  </div>
                )}
                <div class="body">
                  <div class="meta">
                    <span>{a.ko}</span>
                    <span class="dot" aria-hidden="true">·</span>
                    <span>{p.period}</span>
                    {p.links.repoPrivate && (
                      <span class="lock" title="비공개 레포 — 요청 시 코드 공유">
                        <Icon name="lock" size={12} />
                      </span>
                    )}
                  </div>
                  <h3>{p.title}</h3>
                  <p class="sum">{p.summary}</p>
                  {p.award && (
                    <p class="award">
                      <Icon name="trophy" size={14} />
                      {p.award}
                    </p>
                  )}
                  <span class="more">
                    케이스 스터디 <Icon name="arrow" size={15} />
                  </span>
                </div>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: 14px;
  }
  @media (min-width: 720px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 1080px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .link {
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    background: var(--surface);
    overflow: hidden;
    transition: border-color 0.3s, background 0.3s;
  }
  .link:hover {
    border-color: var(--green-line);
    background: var(--surface-2);
  }
  .hl {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 26px 26px 22px;
    border-bottom: 1px solid var(--line);
  }
  .hl-v {
    font-size: clamp(40px, 4.4vw, 56px);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1;
    color: var(--green);
    font-variant-numeric: tabular-nums;
  }
  .hl-l {
    font-size: 13px;
    color: var(--muted);
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
    padding: 22px 26px 26px;
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: var(--muted);
  }
  .lock {
    margin-left: auto;
  }
  h3 {
    font-size: clamp(20px, 2vw, 24px);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.3;
  }
  .sum {
    color: var(--text-2);
    font-size: 14px;
    line-height: 1.65;
  }
  .award {
    display: flex;
    gap: 8px;
    align-items: flex-start;
    color: var(--green);
    font-size: 13px;
  }
  .award :global(svg) {
    flex: none;
    margin-top: 3px;
  }
  .more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: auto;
    padding-top: 10px;
    font-size: 14px;
    font-weight: 600;
  }
  .more :global(svg) {
    transition: transform 0.25s var(--ease);
  }
  .link:hover .more {
    color: var(--green);
  }
  .link:hover .more :global(svg) {
    transform: translateX(4px);
  }
</style>
