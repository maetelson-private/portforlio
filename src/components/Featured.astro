---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { url } from '../lib/url';

interface Props {
  projects: CollectionEntry<'projects'>[];
}
const { projects } = Astro.props;
---

<section class="section featured" id="works" aria-labelledby="featured-title">
  <div class="container">
    <div class="sec-head reveal">
      <div>
        <span class="eyebrow sec-num">★ Featured Work</span>
        <h2 id="featured-title">기획부터 배포까지,<br /><span class="text-green">직접 끝까지.</span></h2>
      </div>
      <p>
        기획·디자인·개발을 모두 맡은 프로젝트입니다. 전략을 세운 사람이 화면을 그리고, 그 화면을 직접 코드로
        옮겼습니다.
      </p>
    </div>

    <ul class="grid">
      {
        projects.map((project, i) => {
          const p = project.data;
          return (
            <li class="fc reveal" style={`transition-delay:${i * 60}ms`}>
              <a href={url(`/projects/${project.id}/`)} class="link">
                {p.highlight && (
                  <div class="hl">
                    <span class="hl-v">{p.highlight.value}</span>
                    <span class="hl-l">{p.highlight.label}</span>
                  </div>
                )}
                <div class="body">
                  <div class="meta">
                    <span class="mono">{p.period}</span>
                    {p.links.repoPrivate && (
                      <span class="tag">
                        <Icon name="lock" size={12} />
                        &nbsp;Private
                      </span>
                    )}
                  </div>
                  <h3>{p.title}</h3>
                  <p class="sum">{p.summary}</p>
                  {p.award && (
                    <p class="award">
                      <Icon name="trophy" size={14} />
                      {p.award}
                    </p>
                  )}
                  <ul class="roles">
                    {p.roles.map((r) => (
                      <li class="tag">{r}</li>
                    ))}
                  </ul>
                  <span class="more">
                    케이스 스터디 보기 <Icon name="arrow" size={15} />
                  </span>
                </div>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: 16px;
  }
  @media (min-width: 860px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .link {
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    background: var(--surface);
    overflow: hidden;
    transition: border-color 0.3s, background 0.3s;
  }
  .link:hover {
    border-color: var(--green-line);
    background: var(--surface-2);
  }
  .hl {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 28px 28px 24px;
    border-bottom: 1px solid var(--line);
  }
  .hl-v {
    font-size: clamp(48px, 6vw, 72px);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--green);
    font-variant-numeric: tabular-nums;
  }
  .hl-l {
    font-size: 13px;
    color: var(--muted);
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
    padding: 24px 28px 28px;
  }
  .meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
  }
  h3 {
    font-size: clamp(22px, 2.4vw, 28px);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.25;
  }
  .sum {
    color: var(--text-2);
    font-size: 15px;
  }
  .award {
    display: flex;
    gap: 8px;
    align-items: flex-start;
    color: var(--green);
    font-size: 13px;
  }
  .award :global(svg) {
    flex: none;
    margin-top: 3px;
  }
  .roles {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: auto;
    padding-top: 10px;
    font-size: 14px;
    font-weight: 600;
  }
  .link:hover .more {
    color: var(--green);
  }
</style>
