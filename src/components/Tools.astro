---
import * as simpleIcons from 'simple-icons';
import { toolGroups } from '../data/tools';

// Build-time lookup: slug -> SVG path (no client JS)
const icons = simpleIcons as unknown as Record<string, { path: string; title: string } | undefined>;
const iconFor = (slug?: string) => (slug ? icons[`si${slug[0].toUpperCase()}${slug.slice(1)}`] : undefined);
---

<section class="section tools" id="tools" aria-labelledby="tools-title">
  <div class="container">
    <div class="sec-head reveal">
      <h2 id="tools-title">Tools</h2>
      <p>What I use day to day, grouped by the kind of work. Every tool here shows up in at least one project.</p>
    </div>

    <div class="groups">
      {
        toolGroups.map((g) => (
          <div class="group reveal">
            <h3 class="rule-title">{g.group}</h3>
            <ul>
              {g.tools.map((t) => {
                const ic = iconFor(t.icon);
                return (
                  <li>
                    <span class="ic" aria-hidden="true">
                      {ic ? (
                        <svg viewBox="0 0 24 24" width="20" height="20">
                          <path d={ic.path} fill="currentColor" />
                        </svg>
                      ) : (
                        <svg viewBox="0 0 24 24" width="20" height="20">
                          <rect x="2.5" y="2.5" width="19" height="19" rx="5" fill="none" stroke="currentColor" stroke-width="1.5" />
                          <text x="12" y="16.2" text-anchor="middle" font-size="11" font-weight="700" fill="currentColor" font-family="Pretendard Variable, Pretendard, sans-serif">
                            {t.name[0]}
                          </text>
                        </svg>
                      )}
                    </span>
                    <span class="name">{t.name}</span>
                    {t.note && <span class="note">{t.note}</span>}
                  </li>
                );
              })}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .groups {
    display: grid;
    gap: clamp(36px, 5vw, 56px);
  }
  @media (min-width: 960px) {
    .group {
      display: grid;
      grid-template-columns: 240px minmax(0, 1fr);
      gap: 48px;
      align-items: start;
    }
    .group .rule-title {
      margin-bottom: 0;
      padding-top: 16px;
    }
  }
  ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line-strong);
  }
  li {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 56px;
    padding: 12px 16px 12px 0;
    border-bottom: 1px solid var(--line);
  }
  .ic {
    display: grid;
    place-items: center;
    flex: none;
    width: 20px;
    height: 20px;
    color: var(--text);
    transition: color 0.25s, transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  li:hover .ic {
    color: var(--green);
    transform: translateY(-2px);
  }
  .name {
    font-size: 15px;
    color: var(--text);
  }
  .note {
    margin-left: auto;
    font-size: 12px;
    color: var(--muted);
    white-space: nowrap;
  }
</style>
