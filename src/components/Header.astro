---
import { url } from '../lib/url';

const current = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '').split('/')[1] ?? '';
const nav = [
  { key: '', label: 'Work', href: url('/#work') },
  { key: 'about', label: 'About', href: url('/about/') },
  { key: 'contact', label: 'Contact', href: url('/#contact') },
];
---

<header class="header" data-header>
  <div class="container inner">
    <a class="brand" href={url('/')} aria-label="maetelson home">
      <img src={url('/workmark.svg')} alt="maetelson" width="129" height="18" />
    </a>
    <nav aria-label="Main">
      <ul>
        {
          nav.map((n) => (
            <li>
              <a href={n.href} aria-current={current === n.key ? 'page' : undefined}>
                {n.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const h = document.querySelector<HTMLElement>('[data-header]');
  const onScroll = () => h?.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid transparent;
    transition: background 0.3s, border-color 0.3s;
  }
  .header.is-scrolled {
    background: rgba(10, 11, 10, 0.86);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    border-bottom-color: var(--line);
  }
  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 68px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .brand img {
    height: 18px;
    width: auto;
    transition: opacity 0.2s;
  }
  .brand:hover img {
    opacity: 0.7;
  }
  nav ul {
    display: flex;
    gap: 2px;
  }
  nav a {
    display: block;
    padding: 12px 12px;
    font-size: 14px;
    color: var(--text-2);
    background: linear-gradient(var(--green), var(--green)) 50% calc(100% - 4px) / 0 1px no-repeat;
    transition: color 0.2s, background-size 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--text);
    background-size: calc(100% - 24px) 1px;
  }
  @media (max-width: 480px) {
    nav a {
      padding: 12px 8px;
      font-size: 13px;
    }
    nav a:hover,
    nav a[aria-current='page'] {
      background-size: calc(100% - 16px) 1px;
    }
  }
</style>
