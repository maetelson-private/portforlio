---
import { axes, axisOrder } from '../data/site';
import { url } from '../lib/url';

const current = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '').split('/')[1] ?? '';
const nav = [
  ...axisOrder.map((k) => ({ key: k, label: axes[k].ko, href: url(`/${k}/`) })),
  { key: 'about', label: 'About', href: url('/about/') },
];
---

<header class="header" data-header>
  <div class="container inner">
    <a class="brand" href={url('/')} aria-label="maetelson 홈">
      <img src={url('/workmark.svg')} alt="maetelson" width="129" height="18" />
    </a>
    <nav aria-label="주요 메뉴">
      <ul>
        {
          nav.map((n) => (
            <li>
              <a href={n.href} aria-current={current === n.key ? 'page' : undefined}>
                {n.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="btn btn-ghost cta" href={url('/#contact')}>Contact</a>
  </div>
</header>

<script>
  const h = document.querySelector<HTMLElement>('[data-header]');
  const onScroll = () => h?.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid transparent;
    transition: background 0.3s, border-color 0.3s;
  }
  .header.is-scrolled {
    background: rgba(10, 11, 10, 0.86);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    border-bottom-color: var(--line);
  }
  .inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 16px;
    min-height: 68px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    padding: 6px 0;
  }
  .brand img {
    height: 18px;
    width: auto;
    transition: opacity 0.2s;
  }
  .brand:hover img {
    opacity: 0.75;
  }
  nav {
    justify-self: center;
    min-width: 0;
  }
  nav ul {
    display: flex;
    gap: 2px;
  }
  nav a {
    position: relative;
    display: block;
    padding: 8px 12px;
    border-radius: 999px;
    font-size: 14px;
    color: var(--text-2);
    white-space: nowrap;
    transition: color 0.2s, background 0.2s;
  }
  nav a:hover {
    color: var(--text);
    background: rgba(255, 255, 255, 0.05);
  }
  nav a[aria-current='page'] {
    color: var(--text);
  }
  nav a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 2px;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    border-radius: 999px;
    background: var(--green);
  }
  .cta {
    justify-self: end;
    height: 38px;
    padding: 0 16px;
    font-size: 13px;
  }
  /* 모바일: 메뉴를 두 번째 줄로 내리고 가로 스크롤 */
  @media (max-width: 900px) {
    .inner {
      grid-template-columns: auto auto;
      justify-content: space-between;
      row-gap: 0;
      padding-top: 10px;
    }
    nav {
      grid-column: 1 / -1;
      grid-row: 2;
      justify-self: stretch;
      margin-inline: calc(var(--gutter) * -1);
      overflow-x: auto;
      scrollbar-width: none;
    }
    nav::-webkit-scrollbar {
      display: none;
    }
    nav ul {
      padding: 6px var(--gutter) 8px;
    }
    nav a {
      padding: 7px 12px;
      font-size: 13px;
    }
  }
</style>
