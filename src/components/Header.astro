---
import { url } from '../lib/url';
const nav = [
  { label: '기획', href: url('#planning') },
  { label: '디자인', href: url('#design') },
  { label: '개발', href: url('#development') },
  { label: '활동', href: url('#experience') },
];
---

<header class="header" data-header>
  <div class="container inner">
    <a class="brand" href={url('/')} aria-label="Maetelson 홈">
      <span class="mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="18" height="18"><path d="M4 18V6l8 7 8-7v12" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </span>
      <span class="brand-text">maetelson</span>
    </a>
    <nav aria-label="주요 메뉴">
      <ul>
        {nav.map((n) => (
          <li>
            <a href={n.href}>{n.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <a class="btn btn-ghost cta" href={url('#contact')}>Contact</a>
  </div>
</header>

<script>
  const h = document.querySelector<HTMLElement>('[data-header]');
  const onScroll = () => h?.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid transparent;
    transition: background 0.3s, border-color 0.3s, backdrop-filter 0.3s;
  }
  .header.is-scrolled {
    background: rgba(10, 11, 10, 0.72);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    border-bottom-color: var(--line);
  }
  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 68px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .mark {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 9px;
    background: var(--green-soft);
    border: 1px solid var(--green-line);
    color: var(--green);
  }
  nav ul {
    display: flex;
    gap: 4px;
  }
  nav a {
    display: block;
    padding: 8px 14px;
    border-radius: 999px;
    font-size: 14px;
    color: var(--text-2);
    transition: color 0.2s, background 0.2s;
  }
  nav a:hover {
    color: var(--text);
    background: rgba(255, 255, 255, 0.05);
  }
  .cta {
    height: 38px;
    padding: 0 16px;
    font-size: 13px;
  }
  @media (max-width: 720px) {
    nav {
      display: none;
    }
  }
</style>
