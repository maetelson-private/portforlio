---
import Icon from './Icon.astro';
import { axes, axisOrder, type AxisKey } from '../data/site';
import type { Project } from '../lib/projects';
import { url } from '../lib/url';

interface Props {
  projects: Project[];
}
const { projects } = Astro.props;

const fieldsOf = (p: Project): AxisKey[] => [p.data.primary, ...p.data.also];
const counts = Object.fromEntries(
  axisOrder.map((k) => [k, projects.filter((p) => fieldsOf(p).includes(k)).length]),
) as Record<AxisKey, number>;
// 수상 문구가 길면 첫 항목만
const shortAward = (a?: string) => (a ? a.split(' · ')[0] : '');
const leads = Object.fromEntries(axisOrder.map((k) => [k, axes[k].lead]));
const labels = Object.fromEntries(axisOrder.map((k) => [k, axes[k].label]));
---

<section class="work" id="work" aria-labelledby="work-title">
  <div class="container">
    <h2 id="work-title" class="title">Selected work</h2>
    <div class="bar" data-bar>
      <div class="now">
        <span class="now-label">Showing</span>
        <span class="current" data-current>All fields</span>
      </div>
      <div class="filters" role="group" aria-label="Filter by field" data-filters>
        <button type="button" data-filter="all" aria-pressed="true">
          All <span class="n">{projects.length}</span>
        </button>
        {
          axisOrder.map((k) => (
            <button type="button" data-filter={k} aria-pressed="false">
              {axes[k].label} <span class="n">{counts[k]}</span>
            </button>
          ))
        }
      </div>
    </div>
    <p class="lead" data-lead aria-live="polite"></p>

    <div class="head" aria-hidden="true">
      <span>Year</span><span>Project</span><span>Field</span><span>Recognition</span>
    </div>
    <ul class="rows" data-rows>
      {
        projects.map((p) => {
          const d = p.data;
          return (
            <li class="row" data-fields={fieldsOf(p).join(' ')} data-primary={d.primary}>
              <a href={url(`/projects/${p.id}/`)}>
                <span class="year">{d.period.slice(0, 4)}</span>
                <span class="main">
                  <span class="title">
                    {d.title}
                    {d.links.repoPrivate && (
                      <span class="lock">
                        <Icon name="lock" size={12} />
                        <span class="sr-only">(private repository)</span>
                      </span>
                    )}
                  </span>
                  <span class="sum">{d.summary}</span>
                </span>
                <span class="field">
                  <span class="primary">{axes[d.primary].label}</span>
                  {d.also.length > 0 && <span class="also">+ {d.also.map((k) => axes[k].label).join(', ')}</span>}
                </span>
                <span class="award">{shortAward(d.award)}</span>
                <span class="go" aria-hidden="true">
                  <Icon name="arrow-up-right" size={16} />
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>
    <p class="empty" data-empty hidden>No projects in this field yet.</p>
  </div>
</section>

<script define:vars={{ leads, labels }}>
  const root = document.getElementById('work');
  const buttons = Array.from(root.querySelectorAll('[data-filter]'));
  const rows = Array.from(root.querySelectorAll('.row'));
  const leadEl = root.querySelector('[data-lead]');
  const currentEl = root.querySelector('[data-current]');
  const bar = root.querySelector('[data-bar]');
  const emptyEl = root.querySelector('[data-empty]');
  let current = 'all';


  function apply(field, push) {
    current = field;
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === field)));
    let shown = 0;
    rows.forEach((r) => {
      const on = field === 'all' || r.dataset.fields.split(' ').includes(field);
      r.hidden = !on;
      if (on) shown++;
    });
    emptyEl.hidden = shown > 0;
    leadEl.textContent = field === 'all' ? '' : leads[field];
    currentEl.textContent = field === 'all' ? 'All fields' : labels[field];
    if (push) {
      const u = new URL(location.href);
      if (field === 'all') u.searchParams.delete('field');
      else u.searchParams.set('field', field);
      history.replaceState(null, '', u);
    }
  }

  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      apply(b.dataset.filter, true);
      if (bar.getBoundingClientRect().top <= 80) {
        const top = root.getBoundingClientRect().top + window.scrollY - 68;
        window.scrollTo({ top, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      }
    }),
  );
  // 고정 바가 붙었는지 표시 (아래 선)
  const sentinel = document.createElement('div');
  bar.before(sentinel);
  new IntersectionObserver(([e]) => bar.classList.toggle('is-stuck', !e.isIntersecting), {
    rootMargin: '-69px 0px 0px 0px',
  }).observe(sentinel);


  // 모바일 필터 줄: 끝까지 밀면 오른쪽 페이드를 없앤다
  const strip = root.querySelector('[data-filters]');
  const edge = () => strip.classList.toggle('at-end', strip.scrollLeft + strip.clientWidth >= strip.scrollWidth - 2);
  strip.addEventListener('scroll', edge, { passive: true });
  window.addEventListener('resize', edge);
  edge();

  const initial = new URL(location.href).searchParams.get('field');
  apply(initial && leads[initial] ? initial : 'all', false);
</script>

<style>
  .work {
    padding-block: clamp(24px, 4vw, 48px) clamp(96px, 12vw, 160px);
  }
  .bar {
    position: sticky;
    top: 68px;
    z-index: 20;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 32px;
    margin-inline: calc(var(--gutter) * -1);
    padding: 12px var(--gutter);
    background: var(--bg);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s;
  }
  .bar.is-stuck {
    border-bottom-color: var(--line);
  }
  .title {
    margin-bottom: clamp(24px, 4vw, 40px);
    font-size: clamp(36px, 6vw, 88px);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.035em;
    text-transform: uppercase;
  }
  .now {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .now-label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .current {
    font-size: 16px;
    font-weight: 600;
    color: var(--text);
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .filters button {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 36px;
    padding: 0 15px;
    line-height: 1;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    font-size: 14px;
    color: var(--text-2);
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }
  .filters button:hover {
    color: var(--text);
    border-color: rgba(255, 255, 255, 0.28);
  }
  .filters button[aria-pressed='true'] {
    color: #03140c;
    background: var(--green);
    border-color: var(--green);
    font-weight: 600;
  }
  .n {
    font-size: 12px;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .lead {
    max-width: 60ch;
    font-size: 15px;
    line-height: 1.7;
    color: var(--text-2);
  }
  .lead:not(:empty) {
    padding-block: 8px 20px;
  }

  .head,
  .row a {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr) 200px 220px 24px;
    gap: 24px;
  }
  .head {
    padding: 0 0 12px;
    border-bottom: 1px solid var(--line-strong);
    font-size: 12px;
    color: var(--muted);
  }
  .head span:last-child {
    grid-column: 4 / 6;
  }
  .rows {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .row {
    border-bottom: 1px solid var(--line);
    transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  /* 한 행에 올리면 나머지는 흐려진다 */
  /* 마우스로 한 행에 올렸을 때만. 키보드 포커스에서는 흐리지 않는다 */
  @media (hover: hover) {
    .rows:hover .row:not(:hover) {
      opacity: 0.55;
    }
  }
  .row a {
    align-items: baseline;
    padding: 22px 0;
  }
  .year {
    font-size: 14px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .main {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }
  .title {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: clamp(18px, 1.8vw, 22px);
    font-weight: 600;
    letter-spacing: -0.02em;
    transition: color 0.25s, transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .lock {
    color: var(--muted);
  }
  .sum {
    font-size: 14px;
    line-height: 1.6;
    color: var(--muted);
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 14px;
  }
  .primary {
    color: var(--text-2);
  }
  .also {
    font-size: 12px;
    color: var(--muted);
  }
  .award {
    font-size: 13px;
    line-height: 1.5;
    color: var(--text-2);
  }
  .go {
    align-self: center;
    color: var(--muted);
    transition: color 0.25s, transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .row a:hover .title,
  .row a:focus-visible .title {
    color: var(--green);
    transform: translateX(6px);
  }
  .row a:hover .go,
  .row a:focus-visible .go {
    color: var(--green);
    transform: translate(3px, -3px);
  }
  .row a:focus-visible {
    outline-offset: -2px;
  }
  .empty {
    padding: 28px 0;
    color: var(--muted);
  }

  @media (max-width: 960px) {
    .head {
      display: none;
    }
    .rows {
      border-top: 1px solid var(--line-strong);
    }
    .row a {
      grid-template-columns: minmax(0, 1fr) 20px;
      gap: 6px 12px;
      padding: 20px 0;
    }
    .year,
    .field {
      grid-column: 1;
    }
    .year {
      order: 0;
      font-size: 12px;
    }
    .main {
      order: 1;
      grid-column: 1;
    }
    .field {
      order: 2;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 6px;
      font-size: 12px;
    }
    .award {
      order: 3;
      grid-column: 1;
      font-size: 12px;
    }
    .award:empty {
      display: none;
    }
    .go {
      grid-column: 2;
      grid-row: 1 / span 2;
      align-self: start;
    }
    .filters {
      flex-wrap: nowrap;
      overflow-x: auto;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      scrollbar-width: none;
    }
    .filters::-webkit-scrollbar {
      display: none;
    }
    .filters {
      -webkit-mask-image: linear-gradient(90deg, #000 calc(100% - 48px), transparent);
      mask-image: linear-gradient(90deg, #000 calc(100% - 48px), transparent);
      padding-right: 48px;
    }
    .filters.at-end {
      -webkit-mask-image: none;
      mask-image: none;
    }
    .filters button {
      flex: none;
      height: 44px;
    }

  }
</style>
