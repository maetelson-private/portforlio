---
import Ribbon3D from './Ribbon3D.astro';
import { profile } from '../data/site';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container">
    <h1 id="hero-title">{profile.headline}<span class="dot">.</span></h1>
    <p class="intro">{profile.intro}</p>
  </div>
  <Ribbon3D variant="hero" />
</section>

<style>
  .hero {
    padding-top: clamp(64px, 10vw, 128px);
  }
  h1 {
    max-width: 17ch;
    font-size: clamp(40px, 6.4vw, 84px);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .dot {
    color: var(--green);
  }
  .intro {
    margin-top: 24px;
    max-width: 58ch;
    font-size: clamp(16px, 1.5vw, 18px);
    line-height: 1.75;
    color: var(--text-2);
  }
</style>
