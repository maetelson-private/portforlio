---
import Icon from './Icon.astro';
import { url } from '../lib/url';

const proof = [
  { value: '2', label: '기업 산학협력 프로젝트 대상' },
  { value: '115', label: '캡스톤 메인 레포 PR' },
  { value: '18', label: '기획 · 디자인 · 개발 프로젝트' },
];
---

<section class="hero grid-bg" aria-labelledby="hero-title">
  <div class="fade" aria-hidden="true"></div>
  <div class="container inner">
    <div class="left">
      <span class="chip"><Icon name="spark" size={14} /> Profile · 2026</span>
      <h1 id="hero-title">
        <span class="l1">연결하고, 이해하는</span>
        <span class="l2">올라운더, 손하늘.</span>
      </h1>
    </div>
    <div class="right">
      <p>
        문제를 근거로 정의하고, 화면을 직접 그리고, 필요하면 코드까지 짜서 MVP를 끝까지 만듭니다. 기획·디자인·개발 어느
        파트와도 같은 언어로 이야기합니다.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href={url('#works')}>Explore Works <Icon name="arrow" size={16} /></a>
        <a class="btn btn-ghost" href={url('#contact')}>Contact</a>
      </div>
    </div>
  </div>
  <div class="container">
    <dl class="proof">
      {
        proof.map((p) => (
          <div>
            <dt>{p.label}</dt>
            <dd>{p.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: clamp(56px, 9vw, 110px);
    padding-bottom: clamp(24px, 4vw, 40px);
    overflow: hidden;
  }
  .fade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 55%, var(--bg));
    pointer-events: none;
  }
  .inner {
    position: relative;
    display: grid;
    gap: 36px;
  }
  @media (min-width: 900px) {
    .inner {
      grid-template-columns: 1.6fr 1fr;
      gap: 64px;
      align-items: end;
    }
  }
  h1 {
    margin-top: 26px;
    font-weight: 600;
    font-size: clamp(40px, 5.8vw, 74px);
    line-height: 1.16;
    letter-spacing: -0.035em;
  }
  h1 span {
    display: block;
  }
  @media (min-width: 900px) {
    h1 span {
      white-space: nowrap;
    }
  }
  .l2 {
    color: var(--green);
  }
  .right {
    max-width: 420px;
    padding-bottom: 10px;
  }
  .right p {
    color: var(--text-2);
    font-size: 15px;
    line-height: 1.75;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 26px;
  }
  .proof {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: clamp(48px, 7vw, 80px) 0 0;
    border-top: 1px solid var(--line);
  }
  .proof > div {
    display: flex;
    flex-direction: column-reverse;
    gap: 4px;
    padding: 20px 16px 0 0;
  }
  .proof > div + div {
    padding-left: 20px;
    border-left: 1px solid var(--line);
  }
  dt {
    font-size: 13px;
    color: var(--muted);
  }
  dd {
    margin: 0;
    font-size: clamp(28px, 3.4vw, 40px);
    font-weight: 600;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }
</style>
