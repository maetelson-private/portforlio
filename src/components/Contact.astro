---
import Icon from './Icon.astro';
import { profile } from '../data/site';
---

<section class="contact" id="contact" aria-labelledby="contact-title">
  <div class="container">
    <h2 id="contact-title">Contact</h2>
    <p class="note">채용, 협업, 프로젝트 제안 모두 이메일로 연락 주세요.</p>
    <a class="mail" href={`mailto:${profile.email}`}>
      {profile.email}
      <Icon name="arrow-up-right" size={28} />
    </a>
    <ul class="links">
      {
        profile.links.map((l) => (
          <li>
            <a href={l.href} target="_blank" rel="noopener noreferrer">
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .contact {
    padding-block: clamp(80px, 10vw, 140px);
    border-top: 1px solid var(--line);
  }
  h2 {
    font-size: 15px;
    font-weight: 600;
    color: var(--text-2);
  }
  .note {
    margin-top: 12px;
    color: var(--muted);
  }
  .mail {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    margin-top: 28px;
    font-size: clamp(28px, 5.4vw, 64px);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.15;
    overflow-wrap: anywhere;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 2px no-repeat;
    transition: color 0.25s, background-size 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .mail:hover,
  .mail:focus-visible {
    color: var(--green);
    background-size: 100% 2px;
  }
  .mail :global(svg) {
    flex: none;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .mail:hover :global(svg) {
    transform: translate(4px, -4px);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    margin-top: 32px;
  }
  .links a {
    font-size: 15px;
    color: var(--text-2);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 5px;
    transition: color 0.2s, text-decoration-color 0.2s;
  }
  .links a:hover {
    color: var(--green);
    text-decoration-color: var(--green);
  }
</style>
