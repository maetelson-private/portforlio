---
import Icon from './Icon.astro';
import Wave from './Wave.astro';
import { profile } from '../data/site';
---

<section class="section contact" id="contact" aria-labelledby="contact-title">
  <div class="container">
    <div class="box reveal">
      <div class="bg" aria-hidden="true"><Wave seed={7} lines={60} /></div>
      <div class="content">
        <span class="chip"><Icon name="spark" size={14} /> Contact</span>
        <h2 id="contact-title">같이 만들어요.<br /><span class="text-green">연락은 언제나 환영입니다.</span></h2>
        <p>기획이든 디자인이든 개발이든, 어느 파트와도 같은 언어로 이야기할 수 있습니다.</p>
        <div class="actions">
          <a class="btn btn-primary" href={`mailto:${profile.email}`}>
            <Icon name="mail" size={16} />
            {profile.email}
          </a>
          {
            profile.links.map((l) => (
              <a class="btn btn-ghost" href={l.href} target="_blank" rel="noopener noreferrer">
                {l.label} <Icon name="arrow-up-right" size={14} />
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .box {
    position: relative;
    overflow: hidden;
    border-radius: 28px;
    border: 1px solid var(--line-strong);
    background: #070908;
    padding: clamp(32px, 6vw, 72px);
  }
  .bg {
    position: absolute;
    inset: 0;
    opacity: 0.55;
  }
  .bg :global(svg) {
    width: 100%;
    height: 100%;
  }
  .bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, #070908 20%, rgba(7, 9, 8, 0.4) 70%, rgba(7, 9, 8, 0.1));
  }
  .content {
    position: relative;
    max-width: 640px;
  }
  h2 {
    margin-top: 22px;
    font-family: var(--font-display);
    font-size: clamp(32px, 5vw, 56px);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.2;
  }
  p {
    margin-top: 18px;
    color: var(--text-2);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 30px;
  }
</style>
