---
/**
 * 레퍼런스의 리본 웨이브를 빌드 타임 SVG로 생성한다.
 * 수십 개의 베지어 곡선이 한 점에서 퍼지며 꼬이는 형태.
 */
interface Props {
  lines?: number;
  seed?: number;
  class?: string;
}
const { lines = 54, seed = 1, class: cls } = Astro.props;

const W = 600;
const H = 300;
const paths: { d: string; o: number; w: number }[] = [];
for (let i = 0; i < lines; i++) {
  const t = i / (lines - 1);
  const s = Math.sin((t + seed) * Math.PI * 1.3);
  const y0 = H * 0.92 - t * 40;
  const c1x = W * 0.22 + s * 30;
  const c1y = H * (0.95 - t * 0.9);
  const c2x = W * 0.58 - s * 50;
  const c2y = H * (0.05 + t * 0.55) + Math.cos(t * 6 + seed) * 18;
  const x3 = W + 20;
  const y3 = H * (0.08 + t * 0.32);
  paths.push({
    d: `M -20 ${y0.toFixed(1)} C ${c1x.toFixed(1)} ${c1y.toFixed(1)}, ${c2x.toFixed(1)} ${c2y.toFixed(1)}, ${x3} ${y3.toFixed(1)}`,
    o: 0.15 + 0.75 * Math.pow(Math.sin(t * Math.PI), 1.4),
    w: 0.6 + 0.9 * Math.sin(t * Math.PI),
  });
}
const gid = `wg-${seed}`;
---

<svg class={cls} viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  <defs>
    <linearGradient id={gid} x1="0" y1="1" x2="1" y2="0">
      <stop offset="0" stop-color="#0c6b48" />
      <stop offset="0.45" stop-color="#2ee59d" />
      <stop offset="0.8" stop-color="#c9ffe8" />
      <stop offset="1" stop-color="#2ee59d" stop-opacity="0.4" />
    </linearGradient>
    <radialGradient id={`${gid}-glow`} cx="0.55" cy="0.45" r="0.6">
      <stop offset="0" stop-color="#2ee59d" stop-opacity="0.22" />
      <stop offset="1" stop-color="#2ee59d" stop-opacity="0" />
    </radialGradient>
  </defs>
  <rect width={W} height={H} fill={`url(#${gid}-glow)`} />
  <g fill="none" stroke={`url(#${gid})`} class="wave-lines">
    {paths.map((p) => <path d={p.d} stroke-opacity={p.o.toFixed(2)} stroke-width={p.w.toFixed(2)} />)}
  </g>
</svg>

<style>
  .wave-lines {
    transform-origin: 50% 50%;
    animation: drift 12s ease-in-out infinite alternate;
  }
  @keyframes drift {
    from {
      transform: translateY(-4px) scaleY(0.98);
    }
    to {
      transform: translateY(6px) scaleY(1.03);
    }
  }
</style>
