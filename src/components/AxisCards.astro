---
import Icon from './Icon.astro';
import Wave from './Wave.astro';
import { axes, axisOrder, type AxisKey } from '../data/site';
import { url } from '../lib/url';

interface Props {
  counts: Record<AxisKey, number>;
}
const { counts } = Astro.props;
const initial: AxisKey = 'investment';
---

<section class="axes" aria-label="다섯 가지 역량">
  <div class="container">
    <ul class="row" data-axes>
      {
        axisOrder.map((key, i) => {
          const a = axes[key];
          return (
            <li class:list={['card', { 'is-active': key === initial }]} data-key={key}>
              <a class="hit" href={url(`/${key}/`)} aria-label={`${a.ko} 페이지로 이동`} />
              <div class="visual" aria-hidden="true">
                <Wave seed={i + 1} lines={48} />
              </div>
              <span class="ghost" aria-hidden="true">
                {a.no}.
              </span>
              <div class="body">
                <span class="ico">
                  <Icon name={a.icon} size={16} />
                </span>
                <div class="compact">
                  <h3>{a.ko}</h3>
                  <p>{a.en}</p>
                </div>
                <div class="full">
                  <p class="meta">
                    {a.ko} · 프로젝트 {counts[key]}개
                  </p>
                  <h3 class="big">
                    {a.title[0]}
                    <br />
                    {a.title[1]}
                  </h3>
                  <p class="desc">{a.desc}</p>
                  <span class="go">
                    {a.ko} 보기 <Icon name="arrow" size={15} />
                  </span>
                </div>
              </div>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<script>
  const row = document.querySelector<HTMLElement>('[data-axes]');
  if (row) {
    const cards = Array.from(row.querySelectorAll<HTMLElement>('.card'));
    const activate = (c: HTMLElement) => cards.forEach((x) => x.classList.toggle('is-active', x === c));
    cards.forEach((c) => {
      c.addEventListener('pointerenter', () => activate(c));
      c.addEventListener('focusin', () => activate(c));
    });
  }
</script>

<style>
  .axes {
    padding-block: 24px clamp(56px, 8vw, 96px);
  }
  .row {
    display: grid;
    gap: 12px;
  }
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-lg);
    background: var(--surface);
    border: 1px solid var(--line);
    overflow: hidden;
    transition: flex-grow 0.6s var(--ease), height 0.6s var(--ease), border-color 0.3s;
  }
  .hit {
    position: absolute;
    inset: 0;
    z-index: 3;
    border-radius: inherit;
  }
  .visual {
    display: none;
  }
  .ghost {
    display: none;
  }
  .body {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 22px;
  }
  .ico {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--line-strong);
    color: var(--green);
  }
  .compact {
    display: none;
  }
  h3 {
    font-weight: 600;
    letter-spacing: -0.025em;
  }
  .meta {
    font-size: 13px;
    color: var(--muted);
  }
  .big {
    font-size: clamp(24px, 2.6vw, 34px);
    line-height: 1.15;
  }
  .desc {
    color: var(--text-2);
    font-size: 14px;
    line-height: 1.7;
    max-width: 440px;
  }
  .go {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--green);
  }
  .go :global(svg) {
    transition: transform 0.25s var(--ease);
  }
  .card:hover .go :global(svg) {
    transform: translateX(4px);
  }

  /* ─── Desktop: reference-style expanding cards ─── */
  @media (min-width: 960px) {
    .row {
      display: flex;
      align-items: flex-end;
      height: 540px;
    }
    .card {
      flex: 1 1 0;
      min-width: 0;
      height: 380px;
      cursor: pointer;
    }
    .card.is-active {
      flex-grow: 2.6;
      height: 540px;
      border-color: var(--line-strong);
    }
    .visual {
      display: block;
      position: absolute;
      left: 8px;
      right: 8px;
      top: 8px;
      height: 210px;
      border-radius: 16px;
      overflow: hidden;
      background: #070908;
      opacity: 0;
      transform: translateY(-10px) scale(0.98);
      transition: opacity 0.45s var(--ease), transform 0.6s var(--ease);
    }
    .visual :global(svg) {
      width: 100%;
      height: 100%;
    }
    .is-active .visual {
      opacity: 1;
      transform: none;
      transition-delay: 0.12s;
    }
    .ghost {
      display: block;
      position: absolute;
      top: 16px;
      left: 20px;
      font-size: 72px;
      font-weight: 300;
      letter-spacing: -0.04em;
      line-height: 1;
      color: var(--ghost);
      transition: opacity 0.3s;
    }
    .is-active .ghost {
      opacity: 0;
    }
    .body {
      position: absolute;
      inset: auto 0 0 0;
      padding: 24px;
    }
    .compact {
      display: block;
    }
    .compact h3 {
      font-size: 18px;
      line-height: 1.35;
    }
    .compact p {
      margin-top: 2px;
      font-size: 13px;
      color: var(--muted);
    }
    .full {
      display: none;
    }
    .is-active .compact {
      display: none;
    }
    .is-active .full {
      display: flex;
      flex-direction: column;
      gap: 12px;
      animation: rise 0.55s var(--ease) both;
    }
    .card:not(.is-active):hover {
      border-color: var(--line-strong);
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
