---
import { profile } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container inner">
    <span class="copy">© {year} {profile.name} · {profile.handle}</span>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
  }
  .copy {
    font-size: 13px;
    color: var(--muted);
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding-block: 28px;
  }
</style>
