---
import Icon from './Icon.astro';
import Wave from './Wave.astro';
import { disciplines, disciplineOrder, type DisciplineKey } from '../data/site';
import { url } from '../lib/url';

interface Props {
  counts: Record<DisciplineKey, number>;
}
const { counts } = Astro.props;
const icons: Record<DisciplineKey, 'compass' | 'pen' | 'code'> = {
  planning: 'compass',
  design: 'pen',
  development: 'code',
};
const initial: DisciplineKey = 'design';
---

<section class="disc" aria-label="세 가지 역할">
  <div class="container">
    <ul class="row" data-disc>
      {
        disciplineOrder.map((key, i) => {
          const d = disciplines[key];
          return (
            <li class:list={['card', { 'is-active': key === initial }]} data-key={key} style={`--i:${i}`}>
              <a class="hit" href={url(`#${key}`)} aria-label={`${d.ko} 섹션으로 이동`} />
              <div class="visual" aria-hidden="true">
                <Wave seed={i + 1} lines={48} />
              </div>
              <span class="ghost" aria-hidden="true">
                {d.no}.
              </span>
              <div class="body">
                <span class="ico">
                  <Icon name={icons[key]} size={16} />
                </span>
                <div class="compact">
                  <h3>
                    {d.ko}
                    <br />
                    <span>{d.en}</span>
                  </h3>
                </div>
                <div class="full">
                  <p class="mono">
                    {d.no} — {d.en.toUpperCase()} · {counts[key]} PROJECTS
                  </p>
                  <h3 class="big">
                    {d.title[0]}
                    <br />
                    {d.title[1]}
                  </h3>
                  <p class="desc">{d.desc}</p>
                  <ul class="scope">
                    {d.scope.map((s) => (
                      <li class="tag">{s}</li>
                    ))}
                  </ul>
                </div>
              </div>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<script>
  const row = document.querySelector<HTMLElement>('[data-disc]');
  if (row) {
    const cards = Array.from(row.querySelectorAll<HTMLElement>('.card'));
    const activate = (c: HTMLElement) => cards.forEach((x) => x.classList.toggle('is-active', x === c));
    cards.forEach((c) => {
      c.addEventListener('mouseenter', () => activate(c));
      c.addEventListener('focusin', () => activate(c));
    });
  }
</script>

<style>
  .disc {
    padding-block: 24px clamp(40px, 6vw, 72px);
  }
  .row {
    display: grid;
    gap: 14px;
  }
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, var(--surface), var(--bg-elev));
    border: 1px solid var(--line);
    overflow: hidden;
    transition: flex-grow 0.6s var(--ease), transform 0.6s var(--ease), border-color 0.4s, box-shadow 0.6s var(--ease);
  }
  .hit {
    position: absolute;
    inset: 0;
    z-index: 3;
    border-radius: inherit;
  }
  .visual {
    position: relative;
    height: 120px;
    margin: 8px 8px 0;
    border-radius: 16px;
    overflow: hidden;
    background: #070908;
  }
  .visual :global(svg) {
    width: 100%;
    height: 100%;
  }
  .visual::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 50%, rgba(7, 9, 8, 0.85));
  }
  .ghost {
    display: none;
  }
  .body {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 24px;
  }
  .ico {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--line-strong);
    color: var(--green);
  }
  .compact {
    display: none;
  }
  h3 {
    font-family: var(--font-display);
    font-weight: 500;
    letter-spacing: -0.03em;
  }
  .big {
    font-size: clamp(28px, 3.2vw, 38px);
    line-height: 1.08;
    margin-top: 8px;
  }
  .desc {
    color: var(--text-2);
    font-size: 14px;
    line-height: 1.7;
    max-width: 440px;
  }
  .scope {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  /* ─── Desktop: reference-style expanding cards ─── */
  @media (min-width: 900px) {
    .row {
      display: flex;
      align-items: flex-end;
      height: 560px;
    }
    .card {
      flex: 1 1 0;
      height: 400px;
      cursor: pointer;
    }
    .card.is-active {
      flex-grow: 2.2;
      height: 560px;
      border-color: var(--line-strong);
      box-shadow: 0 0 0 1px rgba(46, 229, 157, 0.08);
    }
    .visual {
      position: absolute;
      left: 8px;
      right: 8px;
      top: 0;
      margin: 8px 0 0;
      height: 210px;
      opacity: 0;
      transform: translateY(-10px) scale(0.98);
      transition: opacity 0.5s var(--ease), transform 0.6s var(--ease);
    }
    .is-active .visual {
      opacity: 1;
      transform: none;
      transition-delay: 0.12s;
    }
    .ghost {
      display: block;
      position: absolute;
      top: 18px;
      left: 22px;
      font-family: var(--font-display);
      font-size: 84px;
      font-weight: 400;
      letter-spacing: -0.06em;
      line-height: 1;
      color: var(--ghost);
      transition: opacity 0.35s;
    }
    .is-active .ghost {
      opacity: 0;
    }
    .body {
      position: absolute;
      inset: auto 0 0 0;
      padding: 28px;
    }
    .compact {
      display: block;
    }
    .compact h3 {
      font-size: 19px;
      line-height: 1.3;
    }
    .compact h3 span {
      color: var(--muted);
      font-size: 14px;
      font-family: var(--font-mono);
      letter-spacing: 0.02em;
    }
    .full {
      display: none;
    }
    .is-active .compact {
      display: none;
    }
    .is-active .full {
      display: flex;
      flex-direction: column;
      gap: 14px;
      animation: rise 0.6s var(--ease) both;
    }
    .card:not(.is-active):hover {
      border-color: var(--line-strong);
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
