---
import Wave from './Wave.astro';

interface Props {
  /** hero: 히어로의 큰 리본 / mini: Work 목록 고정 바의 작은 리본 */
  variant?: 'hero' | 'mini';
}
const { variant = 'hero' } = Astro.props;
---

<div class:list={['ribbon', variant]} data-ribbon aria-hidden="true">
  <!-- WebGL이 없거나 스크립트가 실패하면 이 SVG가 그대로 보인다 -->
  <div class="fallback"><Wave seed={2} lines={variant === 'mini' ? 24 : 60} /></div>
  <canvas></canvas>
</div>

<script>
  import type { RibbonPreset, RibbonHandle } from '../lib/ribbon';

  const hosts = Array.from(document.querySelectorAll<HTMLElement>('[data-ribbon]'));
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const handles: RibbonHandle[] = [];
  let pending: RibbonPreset = 'all';

  // 목록이 보내는 분야 신호. three.js 로딩 전에 온 신호는 기억했다가 적용한다
  document.addEventListener('ribbon:preset', (e) => {
    pending = (e as CustomEvent<RibbonPreset>).detail;
    handles.forEach((h) => h.setPreset(pending));
  });

  // 동작 줄이기를 켠 사람에게는 three.js를 내려받지 않고 SVG 리본만 보여준다
  if (!reducedMotion) {
    hosts.forEach((host) => {
      const canvas = host.querySelector('canvas');
      if (!canvas) return;
      const io = new IntersectionObserver(
        async ([entry]) => {
          if (!entry.isIntersecting) return;
          io.disconnect();
          try {
            const { mountRibbon } = await import('../lib/ribbon');
            const handle = mountRibbon(host, canvas, { reducedMotion });
            if (handle) {
              host.classList.add('is-3d');
              handle.setPreset(pending);
              handles.push(handle);
            }
          } catch {
            /* 폴백 SVG 유지 */
          }
        },
        { rootMargin: '200px' },
      );
      io.observe(host);
    });
  }
</script>

<style>
  .ribbon {
    position: relative;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent),
      linear-gradient(180deg, transparent, #000 18%, #000 82%, transparent);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent),
      linear-gradient(180deg, transparent, #000 18%, #000 82%, transparent);
    mask-composite: intersect;
  }
  .hero {
    height: clamp(180px, 24vw, 300px);
  }
  .mini {
    width: 112px;
    height: 40px;
    flex: none;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 20%, #000 80%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 20%, #000 80%, transparent);
  }
  .fallback,
  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .fallback :global(svg) {
    width: 100%;
    height: 100%;
  }
  canvas {
    opacity: 0;
    transition: opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .ribbon.is-3d canvas {
    opacity: 1;
  }
  .ribbon.is-3d .fallback {
    opacity: 0;
    transition: opacity 0.6s;
  }
</style>
