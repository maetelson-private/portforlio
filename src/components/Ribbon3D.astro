---
import Wave from './Wave.astro';
---

<div class="ribbon" data-ribbon aria-hidden="true">
  <!-- WebGL이 없거나 스크립트가 실패하면 이 SVG가 그대로 보인다 -->
  <div class="fallback"><Wave seed={2} lines={60} /></div>
  <canvas></canvas>
</div>

<script>
  import type { RibbonPreset } from '../lib/ribbon';

  const host = document.querySelector<HTMLElement>('[data-ribbon]');
  const canvas = host?.querySelector('canvas');
  if (host && canvas) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let pending: RibbonPreset = 'all';
    let setPreset = (p: RibbonPreset) => {
      pending = p;
    };
    // 목록이 보내는 분야 신호를 받는다 (three.js 로딩 전 신호는 기억해 둔다)
    document.addEventListener('ribbon:preset', (e) => setPreset((e as CustomEvent<RibbonPreset>).detail));

    const io = new IntersectionObserver(
      async ([entry]) => {
        if (!entry.isIntersecting) return;
        io.disconnect();
        try {
          const { mountRibbon } = await import('../lib/ribbon');
          const handle = mountRibbon(host, canvas, { reducedMotion });
          if (handle) {
            host.classList.add('is-3d');
            setPreset = (p) => handle.setPreset(p);
            handle.setPreset(pending);
          }
        } catch {
          /* 폴백 SVG 유지 */
        }
      },
      { rootMargin: '200px' },
    );
    io.observe(host);
  }
</script>

<style>
  .ribbon {
    position: relative;
    height: clamp(180px, 24vw, 300px);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent),
      linear-gradient(180deg, transparent, #000 18%, #000 82%, transparent);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent),
      linear-gradient(180deg, transparent, #000 18%, #000 82%, transparent);
    mask-composite: intersect;
  }
  .fallback,
  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .fallback :global(svg) {
    width: 100%;
    height: 100%;
  }
  canvas {
    opacity: 0;
    transition: opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .ribbon.is-3d canvas {
    opacity: 1;
  }
  .ribbon.is-3d .fallback {
    opacity: 0;
    transition: opacity 0.6s;
  }
</style>
