---
// 예전 분야별 페이지 주소(/strategy/ 등)는 홈 목록의 해당 필터로 보낸다
import { axisOrder } from '../data/site';
import { url } from '../lib/url';

export function getStaticPaths() {
  return axisOrder.map((axis) => ({ params: { axis } }));
}
const target = url(`/?field=${Astro.params.axis}#work`);
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <meta name="robots" content="noindex" />
    <title>Redirecting…</title>
  </head>
  <body style="background:#0a0b0a;color:#edf0ee;font-family:sans-serif">
    <a href={target} style="color:#2ee59d">Work 목록으로 이동</a>
  </body>
</html>
