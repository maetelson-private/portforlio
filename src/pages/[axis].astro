---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { axes, axisOrder, type AxisKey } from '../data/site';
import { getProjects, primaryOf, relatedTo } from '../lib/projects';
import { url } from '../lib/url';

export function getStaticPaths() {
  return axisOrder.map((axis) => ({ params: { axis } }));
}

const key = Astro.params.axis as AxisKey;
const a = axes[key];
const projects = await getProjects();
const main = primaryOf(projects, key);
const related = relatedTo(projects, key);

const idx = axisOrder.indexOf(key);
const next = axes[axisOrder[(idx + 1) % axisOrder.length]];
const nextKey = axisOrder[(idx + 1) % axisOrder.length];
---

<Base title={`${a.ko} — 손하늘 포트폴리오`} description={`${a.lead}. ${a.desc}`}>
  <header class="head grid-bg">
    <div class="fade" aria-hidden="true"></div>
    <div class="container inner">
      <nav class="crumbs" aria-label="역량">
        {
          axisOrder.map((k) => (
            <a href={url(`/${k}/`)} aria-current={k === key ? 'page' : undefined}>
              {axes[k].ko}
            </a>
          ))
        }
      </nav>
      <div class="title">
        <span class="ico"><Icon name={a.icon} size={18} /></span>
        <h1>{a.ko}<span class="text-green">.</span></h1>
        <p class="lead">{a.lead}</p>
      </div>
      <div class="side">
        <p>{a.desc}</p>
        <ul class="scope">
          {a.scope.map((s) => <li class="tag">{s}</li>)}
        </ul>
      </div>
    </div>
  </header>

  <section class="container flow-wrap" aria-labelledby="flow-title">
    <h2 id="flow-title" class="rule-title">{a.ko} 일하는 방식</h2>
    <ol class="flow">
      {
        a.flow.map((f, i) => (
          <li class="reveal" style={`transition-delay:${i * 60}ms`}>
            <span class="ph">phase {i + 1}.</span>
            <p class="en">{f.en}</p>
            <p class="ko">{f.ko}</p>
            <ul>
              {f.items.map((it) => (
                <li>{it}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="container block" aria-labelledby="main-title">
    <h2 id="main-title" class="rule-title"><span>프로젝트 <span class="count">{main.length}</span></span></h2>
    {
      main.length > 0 ? (
        <ul class="list">
          {main.map((p) => (
            <ProjectCard project={p} />
          ))}
        </ul>
      ) : (
        <p class="empty">이 역량의 대표 프로젝트는 정리 중입니다. 아래 관련 프로젝트에서 이 역량이 쓰인 작업을 볼 수 있습니다.</p>
      )
    }
  </section>

  {
    related.length > 0 && (
      <section class="container block" aria-labelledby="rel-title">
        <h2 id="rel-title" class="rule-title">
          <span>
            {a.ko} 역량이 함께 쓰인 프로젝트 <span class="count">{related.length}</span>
          </span>
        </h2>
        <ul class="list">
          {related.map((p) => (
            <ProjectCard project={p} />
          ))}
        </ul>
      </section>
    )
  }

  <nav class="container next" aria-label="다음 역량">
    <a href={url(`/${nextKey}/`)}>
      <span>다음 역량</span>
      <span class="nt">{next.ko} <Icon name="arrow" size={22} /></span>
    </a>
  </nav>
</Base>

<style>
  .head {
    position: relative;
    padding-block: clamp(32px, 5vw, 56px) clamp(40px, 6vw, 72px);
    overflow: hidden;
  }
  .fade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 50%, var(--bg));
    pointer-events: none;
  }
  .inner {
    position: relative;
    display: grid;
    gap: 32px;
  }
  @media (min-width: 900px) {
    .inner {
      grid-template-columns: 1.3fr 1fr;
      align-items: end;
      column-gap: 64px;
    }
    .crumbs {
      grid-column: 1 / -1;
    }
  }
  /* 모바일에서는 헤더 메뉴가 같은 역할을 하므로 숨긴다 */
  @media (max-width: 900px) {
    .crumbs {
      display: none !important;
    }
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: clamp(24px, 4vw, 48px);
  }
  .crumbs a {
    padding: 7px 14px;
    border-radius: 999px;
    border: 1px solid var(--line);
    font-size: 13px;
    color: var(--text-2);
    transition: border-color 0.2s, color 0.2s, background 0.2s;
  }
  .crumbs a:hover {
    color: var(--text);
    border-color: var(--line-strong);
  }
  .crumbs a[aria-current='page'] {
    color: #03140c;
    background: var(--green);
    border-color: var(--green);
    font-weight: 600;
  }
  .ico {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--line-strong);
    color: var(--green);
    margin-bottom: 20px;
  }
  h1 {
    font-size: clamp(44px, 7vw, 88px);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.08;
  }
  .lead {
    margin-top: 14px;
    font-size: clamp(18px, 2vw, 22px);
    font-weight: 500;
    color: var(--text-2);
  }
  .side p {
    color: var(--text-2);
    font-size: 15px;
    line-height: 1.75;
  }
  .scope {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 18px;
  }
  .block {
    padding-block: clamp(40px, 6vw, 64px) 0;
  }
  .count {
    margin-left: 6px;
    font-size: 13px;
    font-weight: 500;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .flow-wrap {
    padding-top: clamp(24px, 4vw, 40px);
  }
  .flow {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line-strong);
  }
  @media (min-width: 900px) {
    .flow {
      grid-template-columns: repeat(5, 1fr);
    }
    .flow > li + li {
      border-left: 1px solid var(--line);
    }
  }
  .flow > li {
    padding: 22px 0 26px;
    border-bottom: 1px solid var(--line);
    transition: background 0.3s;
  }
  @media (min-width: 900px) {
    .flow > li {
      border-bottom: 0;
    }
    .flow > li {
      padding-inline: 20px;
    }
    .flow > li:first-child {
      padding-left: 0;
    }
  }
  .flow > li:hover .en {
    color: var(--green);
  }
  .ph {
    font-size: 13px;
    color: var(--muted);
  }
  .en {
    margin-top: 10px;
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.02em;
    transition: color 0.25s;
  }
  .ko {
    font-size: 15px;
    color: var(--muted);
  }
  .flow ul {
    display: grid;
    gap: 6px;
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }
  .flow ul li {
    font-size: 14px;
    color: var(--text-2);
  }
  .list {
    border-top: 1px solid var(--line-strong);
  }
  .empty {
    padding: 28px 0;
    border-top: 1px solid var(--line-strong);
    color: var(--muted);
  }
  .next {
    padding-block: clamp(64px, 9vw, 112px);
  }
  .next a {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 32px;
    border-top: 1px solid var(--line);
    font-size: 14px;
    color: var(--muted);
  }
  .nt {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    font-size: clamp(30px, 4.5vw, 52px);
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--text);
    transition: color 0.3s, gap 0.3s var(--ease);
  }
  .next a:hover .nt {
    color: var(--green);
    gap: 20px;
  }
</style>
