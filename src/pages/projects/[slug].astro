---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { axes, profile } from '../../data/site';
import { getProjects, type Project } from '../../lib/projects';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const all = await getProjects();
  // 다음 프로젝트는 Work 목록에 보이는 것들 안에서 돈다
  const listed = all.filter((p) => !p.data.archive);
  return all.map((project) => {
    const i = listed.findIndex((p) => p.id === project.id);
    const next = listed[(i + 1) % listed.length];
    return { params: { slug: project.id }, props: { project, next, total: listed.length } };
  });
}

interface Props {
  project: Project;
  next: Project;
  total: number;
}
const { project, next, total } = Astro.props;
const p = project.data;
const a = axes[p.primary];
const { Content } = await render(project);

const fields = [p.primary, ...p.also];
const links = [
  p.links.live && { label: 'Live', href: p.links.live },
  p.links.repo && { label: 'GitHub', href: p.links.repo },
  p.links.figma && { label: 'Figma', href: p.links.figma },
  p.links.notion && { label: 'Notion', href: p.links.notion },
  ...(p.links.extra ?? []),
].filter(Boolean) as { label: string; href: string }[];
---

<Base title={`${p.title} | Haneul Son`} description={p.summary}>
  <article class="cs">
    <header class="container head">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a class="tap" href={url('/#work')}>Work</a>
        <span aria-hidden="true">/</span>
        <a class="tap" href={url(`/?field=${p.primary}#work`)}>{a.label}</a>
      </nav>
      <p class="name">{p.title}</p>
      <h1>{p.summary}</h1>

      {
        (links.length > 0 || p.links.repoPrivate) && (
          <ul class="actions">
            {links.map((l) => (
              <li>
                <a class="tap" href={l.href} target="_blank" rel="noopener noreferrer">
                  {l.label} <Icon name="arrow-up-right" size={14} />
                </a>
              </li>
            ))}
            {p.links.repoPrivate && (
              <li class="private">
                <Icon name="lock" size={13} /> Private repo, available on request
              </li>
            )}
          </ul>
        )
      }
    </header>

    <div class="container body">
      <dl class="facts">
        {
          p.org && (
            <div>
              <dt>Client</dt>
              <dd>{p.org}</dd>
            </div>
          )
        }
        <div>
          <dt>Period</dt>
          <dd>{p.period}</dd>
        </div>
        <div>
          <dt>Role</dt>
          <dd>{p.roles.join(', ')}</dd>
        </div>
        <div>
          <dt>Fields</dt>
          <dd class="fields">
            {fields.map((k) => <a class="tap" href={url(`/?field=${k}#work`)}>{axes[k].label}</a>)}
          </dd>
        </div>
        {
          p.award && (
            <div>
              <dt>Recognition</dt>
              <dd>{p.award.split(' · ').map((x) => <span class="line">{x}</span>)}</dd>
            </div>
          )
        }
        {
          p.stack.length > 0 && (
            <div>
              <dt>Stack</dt>
              <dd class="muted">{p.stack.join(', ')}</dd>
            </div>
          )
        }
      </dl>

      <div class="prose">
        <Content />
      </div>
    </div>

    <section class="container reach" aria-labelledby="reach-title">
      <h2 id="reach-title">Questions about this project, or working on something similar?</h2>
      <div class="reach-links">
        <a class="mail" href={`mailto:${profile.email}`}>
          {profile.email} <Icon name="arrow-up-right" size={18} />
        </a>
        <a class="tap" href={profile.links.find((l) => l.label === 'LinkedIn')?.href} target="_blank" rel="noopener noreferrer">LinkedIn</a>
      </div>
    </section>

    <nav class="container next" aria-label="Next project">
      <a class="next-link" href={url(`/projects/${next.id}/`)}>
        <span class="label">Next project</span>
        <span class="nt">{next.data.title} <Icon name="arrow" size={24} /></span>
        <span class="ns">{next.data.summary}</span>
      </a>
      <a class="all tap" href={url('/#work')}>All work <span>({total})</span></a>
    </nav>
  </article>
</Base>

<style>
  .head {
    padding-block: clamp(48px, 8vw, 104px) clamp(40px, 6vw, 72px);
  }
  .crumbs {
    display: flex;
    gap: 8px;
    font-size: 14px;
    color: var(--muted);
  }
  .crumbs a {
    color: var(--text-2);
    transition: color 0.2s;
  }
  .crumbs a:hover {
    color: var(--green);
  }
  .name {
    margin-top: clamp(32px, 5vw, 56px);
    font-size: 15px;
    font-weight: 600;
    color: var(--green);
  }
  h1 {
    margin-top: 14px;
    max-width: 30ch;
    font-size: clamp(28px, 3.4vw, 44px);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
    margin-top: 32px;
  }
  .actions a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 15px;
    font-weight: 600;
    background: linear-gradient(currentColor, currentColor) 0 100% / 100% 1px no-repeat;
    padding-bottom: 3px;
    transition: color 0.2s;
  }
  .actions a:hover {
    color: var(--green);
  }
  .actions a :global(svg) {
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .actions a:hover :global(svg) {
    transform: translate(2px, -2px);
  }
  .private {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    color: var(--muted);
  }

  /* ── body: facts column + prose ── */
  .body {
    display: grid;
    gap: 48px;
    padding-block: clamp(32px, 5vw, 56px) clamp(64px, 9vw, 120px);
    border-top: 1px solid var(--line-strong);
  }
  @media (min-width: 960px) {
    .body {
      grid-template-columns: 280px minmax(0, 1fr);
      gap: 80px;
    }
    .facts {
      position: sticky;
      top: 96px;
      align-self: start;
    }
  }
  .facts {
    display: grid;
    gap: 22px;
    margin: 0;
  }
  dt {
    font-size: 12px;
    font-weight: 600;
    color: var(--muted);
    margin-bottom: 6px;
  }
  dd {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--text);
  }
  .muted {
    color: var(--text-2);
  }
  .line {
    display: block;
  }
  .fields {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
  }
  .fields a {
    color: var(--text-2);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 4px;
    transition: color 0.2s, text-decoration-color 0.2s;
  }
  .fields a:hover {
    color: var(--green);
    text-decoration-color: var(--green);
  }

  /* ── prose: 번호 붙은 섹션, Approach는 단계, Outcome은 행 ── */
  .prose {
    max-width: 68ch;
    counter-reset: sec;
    font-size: 16px;
    line-height: 1.75;
    color: var(--text-2);
  }
  .prose :global(h2) {
    counter-increment: sec;
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin: 64px 0 22px;
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text);
  }
  .prose :global(h2:first-child) {
    margin-top: 0;
  }
  .prose :global(h2)::before {
    content: counter(sec, decimal-leading-zero);
    font-size: 14px;
    font-weight: 500;
    color: var(--green);
    font-variant-numeric: tabular-nums;
  }
  .prose :global(p) {
    margin: 0 0 16px;
  }
  .prose :global(strong) {
    color: var(--text);
    font-weight: 600;
  }
  .prose :global(ul) {
    display: grid;
    gap: 10px;
    margin: 0 0 16px;
    padding: 0;
    list-style: none;
  }
  .prose :global(li) {
    position: relative;
    padding-left: 18px;
  }
  .prose :global(li)::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.75em;
    width: 6px;
    height: 1px;
    background: var(--muted);
  }
  .prose :global(ul ul) {
    margin: 10px 0 0;
  }

  /* Approach: 번호 단계 */
  .prose :global(h2[id^='approach'] + ul) {
    counter-reset: step;
    gap: 0;
    border-top: 1px solid var(--line);
  }
  .prose :global(h2[id^='approach'] + ul > li) {
    counter-increment: step;
    padding: 18px 0 18px 44px;
    border-bottom: 1px solid var(--line);
  }
  .prose :global(h2[id^='approach'] + ul > li)::before {
    content: counter(step);
    top: 18px;
    width: auto;
    height: auto;
    background: none;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.75;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  /* Outcome: 결과 하나에 한 행 */
  .prose :global(h2[id^='outcome'] + ul) {
    gap: 0;
    border-top: 1px solid var(--line);
  }
  .prose :global(h2[id^='outcome'] + ul > li) {
    padding: 16px 0 16px 22px;
    border-bottom: 1px solid var(--line);
    color: var(--text);
  }
  .prose :global(h2[id^='outcome'] + ul > li)::before {
    top: calc(16px + 0.62em);
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--green);
  }
  .prose :global(h2[id^='outcome'] + ul ul li) {
    color: var(--text-2);
  }
  .prose :global(h2[id^='outcome'] + ul ul li)::before {
    width: 6px;
    height: 1px;
    border-radius: 0;
    background: var(--muted);
  }

  .prose :global(code) {
    font-family: var(--font-code);
    font-size: 0.86em;
    padding: 2px 6px;
    border-radius: 6px;
    background: var(--surface-2);
    color: var(--text);
  }
  .prose :global(blockquote) {
    margin: 28px 0 0;
    padding: 4px 0 4px 18px;
    border-left: 1px solid var(--green);
  }
  .prose :global(blockquote p) {
    margin: 0;
    color: var(--text);
  }

  /* ── contact ── */
  .reach {
    display: grid;
    gap: 18px;
    padding-block: 40px 48px;
    border-top: 1px solid var(--line);
  }
  @media (min-width: 900px) {
    .reach {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 40px;
    }
  }
  .reach h2 {
    max-width: 34ch;
    font-size: clamp(18px, 1.8vw, 22px);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.4;
  }
  .reach-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 24px;
  }
  .reach .mail {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-size: 17px;
    font-weight: 600;
    color: var(--green);
    background: linear-gradient(currentColor, currentColor) 0 calc(100% - 8px) / 0 1px no-repeat;
    transition: background-size 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .reach .mail:hover {
    background-size: 100% 1px;
  }
  .reach-links a.tap {
    font-size: 15px;
    color: var(--text-2);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 5px;
  }
  .reach-links a.tap:hover {
    color: var(--green);
  }

  /* ── next ── */
  .next {
    display: grid;
    gap: 24px;
    padding-block: 40px clamp(72px, 10vw, 128px);
    border-top: 1px solid var(--line);
  }
  @media (min-width: 900px) {
    .next {
      grid-template-columns: 1fr auto;
      align-items: end;
    }
  }
  .next-link {
    display: grid;
    gap: 10px;
  }
  .label {
    font-size: 13px;
    color: var(--muted);
  }
  .nt {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    font-size: clamp(30px, 4.4vw, 52px);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.15;
    transition: color 0.3s, gap 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .ns {
    max-width: 56ch;
    font-size: 15px;
    color: var(--text-2);
  }
  .next-link:hover .nt {
    color: var(--green);
    gap: 20px;
  }
  .all {
    font-size: 15px;
    color: var(--text-2);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 5px;
    transition: color 0.2s;
  }
  .all span {
    color: var(--muted);
  }
  .all:hover {
    color: var(--green);
  }
</style>
