---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { url } from '../lib/url';
import { abs } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  /** og/ 폴더의 이미지 이름 (확장자 빼고) */
  ogImage?: string;
  ogType?: 'website' | 'article' | 'profile';
  /** JSON-LD 항목들. @graph로 묶어서 넣는다 */
  schema?: object[];
}
const {
  title = 'Haneul Son (Maetelson) | Strategy, Investment, Data, Design, Development',
  description = 'Portfolio of Haneul Son: business strategy, investment due diligence, data analysis, design, and development.',
  ogImage = 'home',
  ogType = 'website',
  schema,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = abs(`/og/${ogImage}.png`, Astro.site);
const jsonld = schema && JSON.stringify({ '@context': 'https://schema.org', '@graph': schema });
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0a0b0a" />

    <meta name="author" content="Haneul Son" />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <link rel="alternate" type="text/plain" title="LLM summary" href={url('/llms.txt')} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Haneul Son" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {jsonld && <script type="application/ld+json" set:html={jsonld} />}

    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <script is:inline>
      document.documentElement.classList.remove('no-js');
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      const els = document.querySelectorAll<HTMLElement>('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-in'));
      }
      // 안전장치: 어떤 이유로든 관찰이 늦어도 콘텐츠가 숨은 채로 남지 않게
      setTimeout(() => els.forEach((el) => el.classList.add('is-in')), 1500);
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 16px;
    top: -60px;
    z-index: 100;
    padding: 10px 14px;
    border-radius: 8px;
    background: var(--green);
    color: #03140c;
    font-weight: 600;
  }
  .skip:focus {
    top: 12px;
  }
</style>
